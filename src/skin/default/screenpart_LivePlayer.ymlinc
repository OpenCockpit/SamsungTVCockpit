screen:
  name: "LivePlayer"
  children:
    - xmlinc:
        file: "screenpart_PlayerPanel.ymlinc"
        position: "0,0"
    - widget:
        backgroundColor: "md_surface"
        font: "md_headline_medium"
        noWrap: "1"
        position: "362,75"
        render: "Label"
        size: "1120,50"
        source: "session.Event_Now"
        transparent: "1"
        valign: "center"
        children:
          - convert:
              type: "EventName"
              text: "Name"
    - widget:
        backgroundColor: "md_surface"
        font: "md_headline_small_emphasized"
        foregroundColor: "md_on_surface"
        halign: "center"
        position: "667,4"
        render: "Label"
        size: "180,51"
        source: "session.Event_Now"
        transparent: "1"
        valign: "center"
        children:
          - convert:
              type: "COCEventTime"
              text: "Position"
    - widget:
        backgroundColor: "md_surface"
        font: "md_headline_small_emphasized"
        halign: "center"
        position: "857,4"
        render: "Label"
        size: "180,51"
        source: "session.Event_Now"
        transparent: "1"
        valign: "center"
        children:
          - convert:
              type: "EventTime"
              text: "Duration"
          - convert:
              type: "ClockToText"
              text: "InMinutes"
    - widget:
        backgroundColor: "md_surface"
        font: "md_headline_small_emphasized"
        foregroundColor: "md_on_surface"
        halign: "center"
        position: "1047,4"
        render: "Label"
        size: "180,51"
        source: "session.Event_Now"
        transparent: "1"
        valign: "center"
        children:
          - convert:
              type: "COCEventTime"
              text: "Remaining,Negate"
    - eLabel:
        backgroundColor: "md_surface_container"
        position: "362,150"
        size: "1170,4"
        transparent: "0"
        zPosition: "1"
    - widget:
        alphatest: "blend"
        cornerRadius: "$radius_bar_thick"
        foregroundColor: "md_primary"
        position: "362,145"
        render: "Progress"
        size: "1170,12"
        source: "session.Event_Now"
        transparent: "1"
        zPosition: "3"
        children:
          - convert:
              type: "EventTime"
              text: "Progress"
    - widget:
        backgroundColor: "md_surface"
        font: "md_display_medium_emphasized"
        foregroundColor: "md_on_surface"
        halign: "center"
        position: "1552,65"
        render: "Label"
        size: "320,60"
        source: "session.Event_Now"
        transparent: "1"
        valign: "top"
        zPosition: "20"
        children:
          - convert:
              type: "EventTime"
              text: "EndTime"
          - convert:
              type: "ClockToText"
              text: "Format:>%H:%M"
